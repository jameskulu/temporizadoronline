---
import Base from '../../layouts/Base.astro';

interface Props {
	error: unknown;
}

const { error } = Astro.props as Props;
const safeMessage =
	error instanceof Error && typeof error.message === 'string'
		? error.message.slice(0, 200)
		: '';
---

<Base
	title="Server-Fehler – Online-Timer"
	description="Beim Online-Timer ist ein unerwarteter Fehler aufgetreten. Versuchen Sie es in Kürze erneut oder nutzen Sie weiterhin den Timer, die Stoppuhr oder Pomodoro."
	path="/500/"
	robots="noindex, follow"
>
	<main class="mx-auto max-w-3xl px-4 pt-24 pb-24 md:pt-32">
		<div
			class="text-6xl font-bold tracking-tight md:text-7xl"
			style="color: var(--color-accent)"
		>
			500
		</div>
		<h1 class="mt-4 text-2xl font-semibold tracking-tight" style="color: var(--color-ink)">
			Auf dem Server ist etwas schiefgelaufen
		</h1>
		<p class="mt-3 max-w-lg leading-relaxed" style="color: var(--color-ink-muted)">
			Beim Laden dieser Seite ist ein unerwarteter Fehler aufgetreten. Laden Sie in Kürze neu oder
			nutzen Sie eines der Werkzeuge unten, um den Rhythmus nicht zu verlieren.
		</p>

		{
			safeMessage && (
				<div
					class="mt-4 max-w-lg rounded-xl border px-4 py-3 text-sm break-words"
					style="border-color: var(--color-border); color: var(--color-ink-muted)"
				>
					{safeMessage}
				</div>
			)
		}

		<div class="mt-8 flex flex-wrap gap-2">
			<a href="/de/" class="chip chip-link">Start</a>
			<a href="/de/temporizador/" class="chip chip-link">Timer</a>
			<a href="/de/cronometro/" class="chip chip-link">Stoppuhr</a>
			<a href="/de/pomodoro/" class="chip chip-link">Pomodoro</a>
			<a href="/de/intervalos/" class="chip chip-link">Intervalle</a>
			<a href="/de/sequencias/" class="chip chip-link">Sequenzen</a>
		</div>

		<a
			href="/de/temporizador/"
			class="mt-10 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold no-underline transition-transform active:scale-[0.98]"
			style="background: var(--color-accent); color: var(--color-inverse)"
		>
			Timer jetzt verwenden
		</a>
	</main>
</Base>