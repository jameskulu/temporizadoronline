---
import Base from '../layouts/Base.astro';
import TimerApp from '../components/TimerApp.astro';
import ToolsGrid from '../components/ToolsGrid.astro';
import { faqJsonLd, webAppJsonLd } from '../data/site';

const faqs = [
	{
		q: 'Como usar o temporizador online?',
		a: 'Escolha uma duração pronta ou ajuste horas, minutos e segundos. Toque em Iniciar para começar; você pode pausar, retomar ou reiniciar a contagem.',
	},
	{
		q: 'O temporizador toca um alarme sonoro?',
		a: 'Sim. O navegador pode exigir uma interação antes de liberar áudio. Teste o som antes de começar e mantenha esta página aberta se precisar ouvir o aviso.',
	},
	{
		q: 'Não consigo ouvir o alarme. O que posso fazer?',
		a: 'Abra Configurações, toque em Testar som, confira se o temporizador não está silenciado e aumente o volume. Verifique também o volume do aparelho e as permissões do navegador. Se o celular suspender a página ou bloquear o áudio, o aviso sonoro pode não tocar.',
	},
	{
		q: 'A contagem continua correta se eu trocar de aba ou bloquear a tela?',
		a: 'O tempo restante é recalculado pelo relógio quando você volta à página. Isso não garante que o navegador mantenha a página ativa nem que o alarme toque enquanto o aparelho estiver bloqueado ou suspenso.',
	},
	{
		q: 'O temporizador online é gratuito e funciona no celular?',
		a: 'Sim. Você pode usar o temporizador no navegador do celular ou do computador, sem cadastro. Os controles se ajustam à tela e o áudio depende das permissões e configurações do aparelho.',
	},
];
---
<Base
	title="Temporizador Online com Alarme e Tela Cheia | Grátis"
	description="Configure seu temporizador online com alarme sonoro e tela cheia. Escolha minutos ou horas, inicie a contagem regressiva e controle seu tempo sem cadastro."
	path="/"
	jsonLd={[webAppJsonLd(), faqJsonLd(faqs)]}
>
	<div class="mx-auto max-w-page px-4 pt-6 pb-20 md:pt-8">
		<section class="text-center mb-5 hero-mesh">
			<h1 class="text-3xl md:text-4xl font-semibold tracking-tight">Temporizador Online com Alarme</h1>
			<p class="mt-2 text-base md:text-lg" style="color:var(--color-body)">
				Configure a contagem regressiva, escolha um som e acompanhe o tempo — grátis e sem cadastro.
			</p>
		</section>

		<section class="app-card rounded-[16px] p-4 md:p-8 mb-8" aria-label="Temporizador online">
			<TimerApp scope="full" />
		</section>

		<section class="article">
			<h2 class="text-2xl font-semibold mb-3">Atalhos de duração</h2>
			<p class="lead">Abra uma contagem já configurada. Ela só começa quando você toca em Iniciar.</p>
			<nav class="flex flex-wrap gap-2" aria-label="Durações prontas">
				<a class="chip chip-link" href="/temporizador/5-minutos/">5 minutos</a>
				<a class="chip chip-link" href="/temporizador/10-minutos/">10 minutos</a>
				<a class="chip chip-link" href="/temporizador/15-minutos/">15 minutos</a>
				<a class="chip chip-link" href="/temporizador/25-minutos/">25 minutos</a>
				<a class="chip chip-link" href="/temporizador/30-minutos/">30 minutos</a>
				<a class="chip chip-link" href="/temporizador/60-minutos/">1 hora</a>
			</nav>

			<h2 class="text-2xl font-semibold mt-10 mb-3">Como usar</h2>
			<ol class="instructions">
				<li>Escolha uma duração pronta ou ajuste horas, minutos e segundos.</li>
				<li>Toque em <strong>Iniciar</strong>; use <strong>Pausar</strong> ou <strong>Retomar</strong> quando precisar.</li>
				<li>Quando terminar, toque em <strong>Reiniciar</strong> para configurar a próxima contagem.</li>
			</ol>

			<h2 class="text-2xl font-semibold mt-10 mb-3">Recursos do temporizador</h2>
			<ul class="feature-list">
				<li><strong>Alarme sonoro:</strong> escolha entre sons e ajuste o volume nas configurações. Use “Testar som” antes de iniciar.</li>
				<li><strong>Tela cheia:</strong> amplie o mostrador pelo botão de tela cheia; a disponibilidade depende do navegador e do aparelho.</li>
				<li><strong>Link compartilhável:</strong> envie uma contagem já configurada para outra pessoa.</li>
				<li><strong>Contagem precisa:</strong> ao voltar de outra aba, o tempo restante é recalculado; a reprodução do alarme em segundo plano não é garantida.</li>
			</ul>

			<h2 class="text-2xl font-semibold mt-10 mb-3">Perguntas frequentes</h2>
			<div class="faq">
				{faqs.map((f) => (
					<div class="faq-item">
						<h3 class="faq-q">{f.q}</h3>
						<p class="faq-a">{f.a}</p>
					</div>
				))}
			</div>
		</section>

		<section class="article mt-10">
			<h2 class="text-2xl font-semibold mb-2">Outras ferramentas de tempo</h2>
			<p class="lead">Escolha uma ferramenta para um uso específico.</p>
			<ToolsGrid />
		</section>
	</div>
</Base>

<style>
	.app-card {
		background: var(--color-canvas-elevated);
		border: 1px solid var(--color-hairline);
		box-shadow: var(--shadow-whisper);
	}
	.article h2 {
		line-height: 1.25;
	}
	.lead {
		font-size: 16px;
		color: var(--color-body);
		margin-bottom: 1rem;
	}
	.article p {
		color: var(--color-body);
		margin-bottom: 0.8rem;
		line-height: 1.6;
	}
	.article a {
		color: var(--color-link);
		text-decoration: none;
	}
	.article a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.instructions {
		padding-left: 1.4rem;
		list-style: decimal;
		color: var(--color-body);
	}
	.instructions li {
		padding-left: 0.25rem;
		margin-bottom: 0.5rem;
		line-height: 1.6;
	}
	.feature-list {
		display: grid;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		color: var(--color-body);
	}
	.feature-list strong {
		color: var(--color-ink);
	}
	.faq {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}
	.faq-item {
		padding: 14px 16px;
		border-radius: 12px;
		background: var(--color-canvas-elevated);
		border: 1px solid var(--color-hairline);
		box-shadow: var(--shadow-whisper);
	}
	.faq-q {
		font-size: 15px;
		font-weight: 600;
		margin-bottom: 4px;
	}
	.faq-a {
		font-size: 14px;
		color: var(--color-body);
		line-height: 1.6;
	}
</style>
