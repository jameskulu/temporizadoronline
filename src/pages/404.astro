---
import Base from '../layouts/Base.astro';
---

<Base
	title="Página não encontrada — Temporizador Online"
	description="Esta página não existe no Temporizador Online. Continue usando o temporizador, o cronômetro, o pomodoro ou os intervalos regressivos."
	path="/404/"
	robots="noindex, follow"
>
	<main class="mx-auto max-w-3xl px-4 pt-24 pb-24 md:pt-32">
		<div
			class="text-6xl font-bold tracking-tight md:text-7xl"
			style="color: var(--color-accent)"
		>
			404
		</div>
		<h1 class="mt-4 text-2xl font-semibold tracking-tight" style="color: var(--color-ink)">
			Página não encontrada
		</h1>
		<p class="mt-3 max-w-lg leading-relaxed" style="color: var(--color-ink-muted)">
			O endereço digitado não existe ou foi movido. Que tal voltar ao trabalho com uma das
			ferramentas abaixo?
		</p>

		<div class="mt-8 flex flex-wrap gap-2">
			<a href="/" class="chip chip-link">Início</a>
			<a href="/temporizador/" class="chip chip-link">Temporizador</a>
			<a href="/cronometro/" class="chip chip-link">Cronômetro</a>
			<a href="/pomodoro/" class="chip chip-link">Pomodoro</a>
			<a href="/intervalos/" class="chip chip-link">Intervalos</a>
			<a href="/meditacao/" class="chip chip-link">Meditação</a>
			<a href="/sequencias/" class="chip chip-link">Sequências</a>
		</div>

		<a
			href="/temporizador/"
			class="mt-10 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold no-underline transition-transform active:scale-[0.98]"
			style="background: var(--color-accent); color: var(--color-inverse)"
		>
			Usar o temporizador agora
		</a>
	</main>
</Base>