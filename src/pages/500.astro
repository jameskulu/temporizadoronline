---
import Base from '../layouts/Base.astro';

interface Props {
	error: unknown;
}

const { error } = Astro.props as Props;
const safeMessage =
	error instanceof Error && typeof error.message === 'string'
		? error.message.slice(0, 200)
		: '';
---

<Base
	title="Erro no servidor — Temporizador Online"
	description="Ocorreu um erro inesperado no Temporizador Online. Tente novamente em instantes ou continue usando o temporizador, o cronômetro ou o pomodoro."
	path="/500/"
	robots="noindex, follow"
>
	<main class="mx-auto max-w-3xl px-4 pt-24 pb-24 md:pt-32">
		<div
			class="text-6xl font-bold tracking-tight md:text-7xl"
			style="color: var(--color-accent)"
		>
			500
		</div>
		<h1 class="mt-4 text-2xl font-semibold tracking-tight" style="color: var(--color-ink)">
			Algo deu errado no servidor
		</h1>
		<p class="mt-3 max-w-lg leading-relaxed" style="color: var(--color-ink-muted)">
			Um erro inesperado aconteceu ao carregar esta página. Recarregue em instantes ou use
			uma das ferramentas abaixo para não perder o ritmo.
		</p>

		{
			safeMessage && (
				<div
					class="mt-4 max-w-lg rounded-xl border px-4 py-3 text-sm break-words"
					style="border-color: var(--color-border); color: var(--color-ink-muted)"
				>
					{safeMessage}
				</div>
			)
		}

		<div class="mt-8 flex flex-wrap gap-2">
			<a href="/" class="chip chip-link">Início</a>
			<a href="/temporizador/" class="chip chip-link">Temporizador</a>
			<a href="/cronometro/" class="chip chip-link">Cronômetro</a>
			<a href="/pomodoro/" class="chip chip-link">Pomodoro</a>
			<a href="/intervalos/" class="chip chip-link">Intervalos</a>
			<a href="/sequencias/" class="chip chip-link">Sequências</a>
		</div>

		<a
			href="/temporizador/"
			class="mt-10 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold no-underline transition-transform active:scale-[0.98]"
			style="background: var(--color-accent); color: var(--color-inverse)"
		>
			Usar o temporizador agora
		</a>
	</main>
</Base>