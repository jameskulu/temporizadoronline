---
import Base from '../../layouts/Base.astro';
import { blogArticles } from '../../data/blog';

export function getStaticPaths() {
	return blogArticles.map((article) => ({
		params: { slug: article.slug },
		props: { article },
	}));
}

const { article } = Astro.props;
---

<Base
	title={`${article.title} | Blog Temporizador Online`}
	description={article.description}
	path={`/blog/${article.slug}/`}
	hreflang={false}
>
	<article class="mx-auto max-w-page px-4 pt-8 pb-20">
		<header class="article-header">
			<a class="back-link" href="/blog/">← Todos os artigos</a>
			<p class="post-category">{article.category} · {article.readingTime} min de leitura</p>
			<h1>{article.title}</h1>
			<p class="lead">{article.description}</p>
		</header>

		<div class="article-content">
			<p class="introduction">{article.introduction}</p>
			{article.sections.map((section) => (
				<section>
					<h2>{section.heading}</h2>
					{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
					{section.list && (
						<ul>
							{section.list.map((item) => <li>{item}</li>)}
						</ul>
					)}
				</section>
			))}
		</div>

		<aside class="related-tools" aria-labelledby="related-heading">
			<h2 id="related-heading">Ferramentas relacionadas</h2>
			<ul>
				{article.relatedTools.map((tool) => (
					<li><a href={tool.path}>{tool.label}</a></li>
				))}
			</ul>
		</aside>
	</article>
</Base>

<style>
	.article-header,
	.article-content,
	.related-tools {
		max-width: 760px;
		margin-right: auto;
		margin-left: auto;
	}
	.article-header {
		margin-bottom: 2rem;
	}
	.back-link {
		display: inline-block;
		margin-bottom: 1.5rem;
		color: var(--color-link);
		font-size: 0.9rem;
		text-decoration: none;
	}
	.back-link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.post-category {
		margin-bottom: 0.65rem;
		color: var(--color-link-deep);
		font-size: 0.82rem;
		font-weight: 600;
	}
	h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 650;
		line-height: 1.12;
		letter-spacing: -0.035em;
	}
	.lead {
		margin-top: 0.9rem;
		color: var(--color-body);
		font-size: 1.1rem;
		line-height: 1.65;
	}
	.article-content {
		color: var(--color-body);
		font-size: 1.02rem;
		line-height: 1.75;
	}
	.introduction {
		font-size: 1.12rem;
		line-height: 1.75;
	}
	.article-content section {
		margin-top: 2rem;
	}
	.article-content h2,
	.related-tools h2 {
		margin-bottom: 0.65rem;
		color: var(--color-ink);
		font-size: 1.45rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.article-content p {
		margin-bottom: 0.9rem;
	}
	.article-content ul,
	.related-tools ul {
		margin: 0.5rem 0 1rem;
		padding-left: 1.35rem;
		list-style: disc;
	}
	.article-content li,
	.related-tools li {
		margin-bottom: 0.4rem;
	}
	.related-tools {
		margin-top: 2.5rem;
		padding: 1.25rem 1.4rem;
		border: 1px solid var(--color-hairline);
		border-radius: 16px;
		background: var(--color-canvas-elevated);
		box-shadow: var(--shadow-whisper);
	}
	.related-tools a {
		color: var(--color-link);
		text-decoration: none;
	}
	.related-tools a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
