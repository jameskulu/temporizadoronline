---
import ToolPage from '../../components/ToolPage.astro';
import { MINUTE_PAGES } from '../../data/site';

interface Props {
	minutes: number;
	slugLabel: string;
	initial: string;
}

export function getStaticPaths() {
	return MINUTE_PAGES.map((p) => {
		const initial = JSON.stringify({ seconds: p.minutes * 60, mode: 'timer', label: p.label });
		return {
			params: { slug: p.slug },
			props: { minutes: p.minutes, slugLabel: p.slug, initial },
		};
	});
}

const { minutes, slugLabel, initial } = Astro.props;
const duration = minutes === 60 ? '1 hora' : `${minutes} ${minutes === 1 ? 'minuto' : 'minutos'}`;
const displayDuration = minutes === 60 ? '1 Hora' : `${minutes} ${minutes === 1 ? 'Minuto' : 'Minutos'}`;
const title = `Temporizador de ${displayDuration} com Alarme | Grátis`;
const description = `Temporizador de ${duration} com alarme sonoro. Inicie quando quiser, pause, reinicie, teste o som ou use a tela cheia.`;
const examples: Record<number, string> = {
	1: 'Use um minuto para marcar uma pausa curta ou acompanhar uma tarefa rápida.',
	3: 'Use três minutos para cronometrar uma tarefa breve ou uma pausa entre atividades.',
	5: 'Use cinco minutos para uma pausa curta, preparar uma bebida ou marcar uma tarefa rápida.',
	10: 'Use dez minutos para uma pausa, uma revisão breve ou uma tarefa com horário definido.',
	15: 'Use quinze minutos para revisar anotações, fazer uma pausa ou acompanhar uma atividade curta.',
	20: 'Use vinte minutos para reservar um bloco de trabalho ou acompanhar uma tarefa sem pressa.',
	25: 'Use vinte e cinco minutos para uma sessão individual de foco; para ciclos automáticos, abra o Pomodoro.',
	30: 'Use trinta minutos para organizar uma sessão de trabalho, uma reunião ou uma tarefa doméstica.',
	45: 'Use quarenta e cinco minutos para reservar um bloco de trabalho ou estudo.',
	60: 'Use uma hora para acompanhar uma sessão longa ou dividir uma atividade em blocos menores.',
};
---
<ToolPage
	title={title}
	description={description}
	path={`/temporizador/${slugLabel}/`}
	heading={title.replace(' | Grátis', '')}
	sub={`Contagem regressiva configurada para ${duration}. Ela só começa quando você toca em Iniciar.`}
	initial={initial}
>
	<p class="article-lead">
		O mostrador já está ajustado para <strong>{duration}</strong>, mas permanece parado até você iniciar. Não é
		necessário configurar o tempo novamente.
	</p>
	<h2>Como usar</h2>
	<ul>
		<li>Toque em <strong>Iniciar</strong> para começar a contagem.</li>
		<li>Use <strong>Pausar</strong> e <strong>Retomar</strong> para interromper e continuar.</li>
		<li>Toque em <strong>Reiniciar</strong> para voltar ao tempo inicial.</li>
		<li>Use o botão <strong>Tela cheia</strong> para ampliar o mostrador.</li>
		<li>Toque em <strong>Testar som</strong> para conferir o áudio antes de começar.</li>
	</ul>
	<h2>Uma ideia para {duration}</h2>
	<p>{examples[minutes] ?? `Use ${duration} para reservar um período definido para a sua tarefa.`}</p>
	<p>
		Para escolher outro tempo, use o <a href="/">temporizador online</a> ou selecione uma duração abaixo:
	</p>
	<nav class="flex flex-wrap gap-2 mb-4" aria-label="Outras durações">
		{
			MINUTE_PAGES.filter((p) => p.minutes !== minutes).map((m) => (
				<a href={`/temporizador/${m.slug}/`} class="chip chip-link">{m.minutes === 60 ? '1 hora' : `${m.minutes} min`}</a>
			))
		}
	</nav>
	<p>
		Para ciclos automáticos, veja o <a href="/pomodoro/">Pomodoro</a>. Para contar o tempo para cima, use o
		<a href="/cronometro/">cronômetro</a>.
	</p>
</ToolPage>

<style>
	.article-lead {
		font-size: 16px;
		margin-bottom: 1rem;
	}
	.chip-link {
		text-decoration: none;
	}
</style>
