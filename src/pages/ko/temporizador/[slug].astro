---
import ToolPage from '../../../components/ToolPage.astro';
import { faqJsonLd } from '../../../data/site';
import { getMinutePages } from '../../../i18n/utils';

interface Props {
	minutes: number;
	label: string;
	slugLabel: string;
	initial: string;
}

export function getStaticPaths() {
	return getMinutePages('ko').map((p) => {
		const initial = JSON.stringify({ seconds: p.minutes * 60, mode: 'timer', label: p.label });
		return {
			params: { slug: p.slug },
			props: { minutes: p.minutes, label: p.label, slugLabel: p.slug, initial },
		};
	});
}

const { minutes, label, slugLabel, initial } = Astro.props;

const dur = minutes === 60 ? '1시간' : `${minutes}분`;
const faqs = [
	{
		q: `${label}는 무슨 용도인가요?`,
		a: `약 ${dur}이 걸리는 어떤 작업이든 좋습니다. 공부 집중, 휴식, 신체 단련, 레시피 조리, 짧은 활동까지. 설정 없이 지금 시작하세요.`,
	},
	{
		q: '다른 시간도 사용할 수 있나요?',
		a: '네 — 이 앱은 몇 초부터 24시간까지 어떤 시간이든 설정할 수 있으며, 이 페이지의 모든 준비된 시간도 그대로 쓸 수 있습니다.',
	},
];
---
<ToolPage
	title={`${label} — 무료 온라인 타이머`}
	description={`${label}. 알람 소리, 초 단위 정확도, 집중 모드까지. 빠르고 무료이며 다운로드 없이 오프라인에서도 작동합니다.`}
	path={`/temporizador/${slugLabel}/`}
	heading={label}
	sub={`${dur}으로 설정된 타이머. 시작을 누르고 중요한 일에 집중하세요.`}
	initial={initial}
	jsonLd={faqJsonLd(faqs)}
>
	<p class="article-lead">
		이 타이머는 이미 <strong>{dur}</strong>으로 설정되어 있습니다. 시작을 클릭하거나 <kbd>스페이스 바</kbd>를 누르세요.
		끝나면 알람이 울리고 화면이 깜빡이며, 원하면 추가 시간을 계속 측정할 수 있습니다.
	</p>
	<h2>{dur} 타이머는 어떻게 작동하나요</h2>
	<ul>
		<li><strong>정확성:</strong> 시스템 시계 기반으로 탭을 옮겨도 믿을 수 있습니다.</li>
		<li><strong>알람:</strong> 설정에서 원하는 소리를 고르고 볼륨을 조절하세요.</li>
		<li><strong>집중 모드:</strong> <kbd>F</kbd>를 누르면 큰 시계가 있는 전체 화면이 켜집니다.</li>
		<li><strong>바로 쓸 수 있는 링크:</strong> 링크나 QR 코드로 이 {label} 페이지를 공유할 수 있습니다.</li>
	</ul>
	<h2>{dur} 활용 아이디어</h2>
	<p>
		<a href="/ko/temporizador-para-estudos/">공부</a>에서 짧은 블록으로, <a href="/ko/temporizador-para-exercicios/">운동</a>의
		준비운동으로, <a href="/ko/temporizador-para-cozinha/">레시피</a>의 중간 타이머로, 또는 짧은
		<a href="/ko/temporizador-para-meditacao/">명상 세션</a>으로 활용해 보세요.
	</p>
	<h2>다른 준비된 시간</h2>
	<p>
		같은 화면을 다른 시간으로 미리 설정해 두었습니다. 골라서 시작하세요:
	</p>
	<div class="flex flex-wrap gap-2 mb-4">
		{
			getMinutePages('ko').filter((p) => p.minutes !== minutes).map((m) => (
				<a href={`/ko/temporizador/${m.slug}/`} class="chip chip-link">{m.minutes}분</a>
			))
		}
	</div>
	<p>
		휴식이 자동으로 포함된 전체 사이클은 <a href="/ko/pomodoro/">포모도로</a>, 어떤 일이 얼마나 걸리는지 잴 때는
		<a href="/ko/cronometro/">스톱워치</a>, 운동과 휴식을 번갈아 할 때는 <a href="/ko/intervalos/">인터벌</a>,
		<a href="/ko/temporizador-hiit/">HIIT</a> 또는 <a href="/ko/temporizador-tabata/">타바타</a>를 사용하세요.
	</p>
	<h2>자주 묻는 질문</h2>
	<div class="faq-item"><h3 class="faq-q">{faqs[0].q}</h3><p class="faq-a">{faqs[0].a}</p></div>
	<div class="faq-item"><h3 class="faq-q">{faqs[1].q}</h3><p class="faq-a">{faqs[1].a}</p></div>
</ToolPage>

<style>
	.article-lead {
		font-size: 16px;
		margin-bottom: 1rem;
	}
	.chip-link {
		text-decoration: none;
	}
</style>