---
import Base from '../../layouts/Base.astro';
import TimerApp from '../../components/TimerApp.astro';
import ToolsGrid from '../../components/ToolsGrid.astro';
import { SITE_NAME, SITE_TAGLINE, faqJsonLd, webAppJsonLd } from '../../data/site';

const faqs = [
	{
		q: '온라인 타이머란 무엇인가요?',
		a: '온라인 타이머는 브라우저에서 바로 실행되는 카운트다운입니다. 다운로드하거나 설치할 필요가 없습니다. 온라인 타이머는 오프라인에서도 작동합니다. 페이지를 한 번 열어두면 인터넷이 없어도 계속 쓸 수 있습니다.',
	},
	{
		q: '온라인 타이머는 어떻게 사용하나요?',
		a: '화면에서 분과 초를 선택하고 시작을 누른 뒤 알람이 울릴 때까지 기다리면 됩니다. 스톱워치, 포모도로, 인터벌, 명상, 시퀀스 같은 다른 도구로 바꾸려면 화면 상단의 탭을 누르기만 하면 됩니다. 페이지를 새로고침할 필요가 없습니다.',
	},
	{
		q: '10분, 5분, 15분 카운트다운은 어떻게 하나요?',
		a: '원클릭으로 바로 쓸 수 있는 준비된 버전이 있습니다. 10분, 5분, 15분 온라인 타이머 외에도 1분부터 60분까지 준비되어 있습니다. 화면에서 시간을 조절하거나 빠른 시간 단축키를 눌러 더 빨리 시작할 수 있습니다.',
	},
	{
		q: '온라인 타이머를 포모도로로 쓸 수 있나요?',
		a: '네. 포모도로 모드는 고전적인 방식으로 설정되어 있습니다. 25분 집중, 5분 짧은 휴식, 4사이클마다 15분 긴 휴식. 앱은 단계가 바뀔 때마다 소리를 내고 사이클을 자동으로 진행합니다.',
	},
	{
		q: '여러 타이머를 동시에 사용할 수 있나요?',
		a: '네. "새 타이머"를 눌러 필요한 만큼 추가할 수 있습니다. 각각 고유한 설정, 시간, 소리를 가지며 상단의 탭으로 전환합니다. 이것이 바로 멀티 온라인 타이머 기능입니다.',
	},
	{
		q: '다른 탭으로 이동하거나 화면을 잠가도 타이머가 계속되나요?',
		a: '네. 타이머와 스톱워치는 애니메이션 프레임이 아니라 시스템 시계를 기준으로 합니다. 백그라운드나 휴대폰 잠금 상태에서도 돌아올 때 시간은 정확하게 계산됩니다.',
	},
	{
		q: '온라인 타이머는 무료인가요? 회원가입이 필요한가요?',
		a: '100% 무료이고 회원가입이 없습니다. 카운트다운, 스톱워치, 포모도로, 인터벌, 명상, 시퀀스 등 모든 기능이 제한 없이 제공됩니다.',
	},
	{
		q: '온라인 타이머는 휴대폰에서도 작동하나요?',
		a: '휴대폰과 컴퓨터의 모든 브라우저에서 작동합니다. 설치형(PWA)이라 홈 화면에 추가해 앱처럼 열 수 있으며, 스토어에서 아무것도 설치할 필요가 없습니다.',
	},
];
---
<Base
	title="온라인 타이머 — 무료 카운트다운, 포모도로 & 스톱워치"
	description="무료 온라인 타이머: 5·10·15분 카운트다운, 포모도로, 스톱워치, 인터벌. 예쁘고 빠르며 회원가입 없이 오프라인에서도 작동합니다."
	path="/"
	jsonLd={[webAppJsonLd('ko'), faqJsonLd(faqs)]}
>
	<div class="mx-auto max-w-page px-4 pt-10 pb-20">
		<section class="text-center mb-8 hero-mesh">
			<p class="eyebrow mb-3">온라인 타이머</p>
			<h1 class="text-4xl md:text-5xl font-semibold tracking-tight">{SITE_NAME}</h1>
			<p class="mt-3 text-lg" style="color:var(--color-body)">
				{SITE_TAGLINE}
			</p>
			<div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-[13px]" style="color:var(--color-body)">
				<span class="chip">100% 무료</span>
				<span class="chip">회원가입 없음</span>
				<span class="chip">오프라인 작동</span>
				<span class="chip">설치 가능(PWA)</span>
			</div>
		</section>

		<section class="app-card rounded-[16px] p-4 md:p-8 mb-14">
			<TimerApp scope="full" />
		</section>

		<section class="article">
			<p class="eyebrow mb-3">도구</p>
			<h2 class="text-2xl font-semibold mb-3">필요할 때마다 쓰는 온라인 타이머</h2>
			<p class="lead">
				공부, 운동, 요리, 회의, 명상까지 — 깔끔하고 빠른 디자인으로 한 페이지에서 모두 해결합니다.
				아래에서 타이머 유형을 고르거나 위 화면에서 바로 설정하세요.
			</p>
			<p class="lead">
				특정 용도가 필요하신가요? <a href="/ko/temporizador-para-estudos/">공부</a>,
				<a href="/ko/temporizador-para-exercicios/">운동</a>, <a href="/ko/temporizador-para-cozinha/">요리</a>,
				<a href="/ko/temporizador-para-meditacao/">명상</a>, <a href="/ko/temporizador-hiit/">HIIT</a>,
				<a href="/ko/temporizador-tabata/">타바타</a>용 페이지가 준비되어 있습니다.
			</p>
			<ToolsGrid />
			<h2 class="text-2xl font-semibold mt-12 mb-3">온라인 타이머란 무엇인가요</h2>
			<p>
				<strong>온라인 타이머</strong>는 브라우저에서 바로 실행되는 카운트다운 타이머입니다. 소리 알람이
				있는 역카운트로, 시스템 시계에 의해 시간이 유지됩니다. 분과 초로 시간을 골라 시작을 누르면 앱이
				나머지를 처리합니다 — 소리가 울리고, 진동하며, 0이 지난 뒤에도 추가 시간을 계속 셀 수 있습니다.
				모든 것이 브라우저 안에서 일어나므로 검색창에 "온라인 타이머"를 입력하거나 저장해 둔 바로가기를
				열기만 하면 됩니다. 다운로드도, 회원가입도, 설치도 없습니다.
			</p>
			<p>
				일반 시계와 달리 일상 곳곳에서 시간을 재는 <strong>온라인 타이머 시계</strong>로 활용할 수
				있습니다. 주방의 달걀, 운동 중 휴식, 시험 시간, 15분짜리 회의, 공부 휴식 시간까지. 정확도는
				시스템 시계에서 나오므로 지연도 화면 '깜빡임'도 없습니다 — 탭을 옮기거나 휴대폰을 잠가도 시간은
				정확히 이어집니다.
			</p>
			<h2 class="text-2xl font-semibold mt-12 mb-3">모든 시간을 위한 카운트다운</h2>
			<p>
				기본 모드는 <strong>온라인 역카운트 타이머</strong>입니다. 시계는 선택한 값에서 시작해 0까지
				셉니다. 더 빠르게 시작하려면 준비된 단축키를 쓰세요 — <a href="/ko/temporizador/5-minutos/">5분</a>,
				<a href="/ko/temporizador/10-minutos/">10분</a>, <a
				href="/ko/temporizador/15-minutos/">15분</a>, <a href="/ko/temporizador/25-minutos/">25분</a>, <a
				href="/ko/temporizador/30-minutos/">30분</a>, <a href="/ko/temporizador/60-minutos/">60분</a> —
				또는 화면을 조절해 1초부터 몇 시간까지 원하는 초로 맞출 수 있습니다. 인터벌 운동의
				<strong>40초</strong>처럼 짧은 구간에는 <a href="/ko/temporizador-hiit/">HIIT</a>가 준비되어
				있습니다.
			</p>
			<h2 class="text-2xl font-semibold mt-12 mb-3">포모도로, 스톱워치, 인터벌이 한자리에</h2>
			<p>
				이곳은 완전한 <strong>온라인 포모도로 타이머</strong>입니다. 포모도로 기법은 집중과 휴식을
				사이클로 정리하며, 이 앱은 집중·짧은 휴식·긴 휴식 사이를 자동으로 넘어갑니다.
				<strong>온라인 스톱워치 타이머</strong>로도 쓸 수 있습니다. 탭을 스톱워치로 바꾸면 어떤 활동이든
				랩 기록까지 하며 시간을 잴 수 있습니다. 운동에는 <a href="/ko/intervalos/">인터벌</a>이 운동과
				휴식을 자동으로 번갈아 가며, <a href="/ko/temporizador-tabata/">타바타</a>와 HIIT 프리셋이 들어
				있습니다.
			</p>
			<h2 class="text-2xl font-semibold mt-12 mb-3">예쁘고 간결한 온라인 타이머</h2>
			<p>
				이 <strong>온라인 타이머</strong>를 예쁘고 <strong>감각적인(aesthetic)</strong> 디자인으로 만들기
				위해 노력했습니다. 큰 숫자, 세련된 글꼴, 자동 다크 모드, 시각적 잡음 없이 — 시계와 필요한 것만
				보여 줍니다. <strong>집중 모드</strong>(전체 화면)에서는 화면이 더 커져 공부, 명상, 몰입 감상에
				제격입니다. 다른 서비스가 관심을 끌려고 애쓰는 동안, 여기서는 그냥 시간을 바라보면 됩니다.
			</p>
			<h2 class="text-2xl font-semibold mt-12 mb-3">멀티 온라인 타이머: 한 번에 여러 타이머</h2>
			<p>
				밥, 오븐, 차를 동시에 챙겨야 하시나요? <strong>"새 타이머"</strong> 기능은 이 페이지를
				<strong>멀티 온라인 타이머</strong>로 바꿔 줍니다. 타이머마다 자체 탭, 설정, 소리가 있고 모든
				타이머가 동시에 돌아갑니다. 주방, 교실, 그리고 동시에 여러 번 세야 하는 모든 루틴에 완벽합니다.
			</p>
			<h2 class="text-2xl font-semibold mt-12 mb-3">차별화된 기능</h2>
			<ul class="list list-checks">
				<li><strong>탭 사이에서도 정확:</strong> 시스템 시계를 사용해 탭을 옮기거나 화면을 잠가도 초를 잃지 않습니다.</li>
				<li><strong>집중 모드:</strong> 큰 시계의 전체 화면이라 산만해질 일이 없습니다.</li>
				<li><strong>소리와 진동:</strong> 5가지 스타일의 알람, 조절 가능한 볼륨, 휴대폰 진동.</li>
				<li><strong>타이머 공유:</strong> 설정된 링크나 QR 코드를 보내 휴대폰에서 열 수 있습니다.</li>
				<li><strong>포모도로:</strong> <a href="/ko/pomodoro/">집중·휴식 사이클</a>이 자동으로 진행됩니다.</li>
				<li><strong>스톱워치:</strong> <a href="/ko/cronometro/">흐른 시간을 세고 랩을 기록</a>합니다.</li>
				<li><strong>인터벌과 운동:</strong> <a href="/ko/intervalos/">HIIT</a>, <a href="/ko/temporizador-tabata/">타바타</a>, <a href="/ko/temporizador-hiit/">40×20</a> 프리셋.</li>
				<li><strong>키보드 단축키:</strong> 스페이스 시작/일시정지, R 초기화, F 전체 화면, M 음소거.</li>
				<li><strong>자동 다크 모드:</strong> 시스템 테마를 따릅니다.</li>
			</ul>
		</section>

		<section class="article">
			<p class="eyebrow mb-3">Q&A</p>
			<h2 class="text-2xl font-semibold mt-12 mb-3">자주 묻는 질문</h2>
			<div class="faq">
				{faqs.map((f) => (
					<div class="faq-item">
						<h3 class="faq-q">{f.q}</h3>
						<p class="faq-a">{f.a}</p>
					</div>
				))}
			</div>
		</section>
	</div>
</Base>

<style>
	.app-card {
		background: var(--color-canvas-elevated);
		border: 1px solid var(--color-hairline);
		box-shadow: var(--shadow-whisper);
	}
	.article h2 {
		line-height: 1.25;
	}
	.lead {
		font-size: 16px;
		color: var(--color-body);
		margin-bottom: 1rem;
	}
	.article p {
		color: var(--color-body);
		margin-bottom: 0.8rem;
		line-height: 1.6;
	}
	.article a {
		color: var(--color-link);
		text-decoration: none;
	}
	.article a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		list-style: none;
		padding-left: 0;
	}
	.list-checks li {
		position: relative;
		padding-left: 28px;
		color: var(--color-body);
	}
	.list-checks li strong {
		color: var(--color-ink);
		font-weight: 600;
	}
	.list-checks li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 5px;
		width: 17px;
		height: 15px;
		border-radius: 4px;
		background:
			linear-gradient(135deg, transparent 55%, var(--color-link) 50%) -1px 5px no-repeat,
			linear-gradient(45deg, transparent 45%, var(--color-link) 45%) 5px -2px no-repeat;
		background-size: 9px 9px;
		width: 18px;
		height: 18px;
	}
	.faq {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}
	.faq-item {
		padding: 14px 16px;
		border-radius: 12px;
		background: var(--color-canvas-elevated);
		border: 1px solid var(--color-hairline);
		box-shadow: var(--shadow-whisper);
	}
	.faq-q {
		font-size: 15px;
		font-weight: 600;
		margin-bottom: 4px;
	}
	.faq-a {
		font-size: 14px;
		color: var(--color-body);
	}
</style>