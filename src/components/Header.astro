---
import { SITE_NAME } from '../data/site';
---
<header class="site-header">
	<div class="mx-auto max-w-5xl px-4 py-4 flex items-center justify-between">
		<a href="/" class="flex items-center gap-2 no-underline font-semibold text-[14px]" style="color:var(--color-ink)">
			<span class="flex items-center justify-center w-8 h-8 rounded-[8px] bg-ink text-canvas">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2.5" width="6" height="4" rx="1.2"/><path d="M12 13.5V9"/><circle cx="12" cy="15.5" r="6"/></svg>
			</span>
			<span>{SITE_NAME}</span>
		</a>
		<nav class="hidden md:flex items-center gap-5 text-[13px]" style="color:var(--color-body)">
			<a href="/temporizador/" class="h-link">Temporizador</a>
			<a href="/cronometro/" class="h-link">Cronômetro</a>
			<a href="/pomodoro/" class="h-link">Pomodoro</a>
			<a href="/intervalos/" class="h-link">Intervalos</a>
			<a href="/meditacao/" class="h-link">Meditação</a>
			<a href="/sequencias/" class="h-link">Sequências</a>
		</nav>
	</div>
</header>

<style>
	.h-link {
		text-decoration: none;
		transition: color 0.15s ease;
		font-weight: 500;
	}
	.h-link:hover {
		color: var(--color-link-deep);
	}
</style>