---
import { getLangFromUrl, useTranslations, localPath, getMinutePages } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const minutes = getMinutePages(lang);
---
<section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 mt-8">
	{
		t.toolLinks.map((tool) => (
			<a href={localPath(lang, tool.path)} class="tool-card">
				<span class="tool-name">{tool.label}</span>
				<span class="tool-hint">{tool.hint}</span>
			</a>
		))
	}
</section>

<section class="mt-10">
	<div class="eyebrow mb-3">{t.tools.readyEyebrow}</div>
	<h2 class="text-xl font-semibold mb-2">{t.tools.readyTitle}</h2>
	<p class="text-sm mb-3" style="color:var(--color-body)">
		{t.tools.readySub}
	</p>
	<div class="flex flex-wrap gap-2">
		{
			minutes.map((m) => (
				<a href={localPath(lang, `/temporizador/${m.slug}/`)} class="chip chip-link">{m.minutes} {t.tools.min}</a>
			))
		}
	</div>
</section>

<style>
	.tool-card {
		display: flex;
		flex-direction: column;
		gap: 3px;
		padding: 16px 18px;
		border-radius: 12px;
		text-decoration: none;
		background: var(--color-canvas-elevated);
		border: 1px solid var(--color-hairline);
		box-shadow: var(--shadow-whisper);
		transition:
			transform 0.12s ease,
			border-color 0.16s ease,
			box-shadow 0.16s ease;
	}
	.tool-card:hover {
		border-color: var(--color-mute);
		box-shadow: var(--shadow-floating);
		transform: translateY(-1px);
	}
	.tool-name {
		font-weight: 600;
		font-size: 15px;
		color: var(--color-ink);
	}
	.tool-hint {
		font-size: 13px;
		color: var(--color-body);
	}
	.chip-link {
		text-decoration: none;
	}
</style>