---
/** Interactive timer island. Props:
 *  - `initial`: JSON string of an `Initial` payload (from SEO pages / presets)
 *  - `scope`: 'full' shows categories too (homepage), 'compact' hides extras
 */
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const initial = Astro.props.initial;
const scope = Astro.props.scope ?? 'full';
---
<div id="t-app" data-scope={scope} data-lang={lang} data-initial={initial ?? ''} class="relative">
	<noscript>
		<div class="text-center text-sm rounded-[18px] p-4" style="background:var(--color-canvas-muted);color:var(--color-ink-secondary)">
			{t.noscript}
		</div>
	</noscript>
</div>

<script>
	import { boot } from '../lib/main';
	boot();
</script>