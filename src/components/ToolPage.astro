---
import Base from '../layouts/Base.astro';
import TimerApp from '../components/TimerApp.astro';
import ToolsGrid from '../components/ToolsGrid.astro';

interface Props {
	title: string;
	description: string;
	path: string;
	heading: string;
	sub: string;
	initial?: string;
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { heading, sub, initial } = Astro.props;
---
<Base
	title={Astro.props.title}
	description={Astro.props.description}
	path={Astro.props.path}
	jsonLd={Astro.props.jsonLd}
>
	<article class="mx-auto max-w-5xl px-4 pt-10 pb-20">
		<header class="text-center mb-6 hero-mesh">
			<h1 class="text-4xl font-semibold tracking-tight">{heading}</h1>
			<p class="mt-3 text-lg" style="color:var(--color-body)">{sub}</p>
		</header>

		<section class="app-card rounded-[16px] p-4 md:p-8 mb-12">
			<TimerApp initial={initial} scope="compact" />
		</section>

		<section class="article">
			<slot />
		</section>

		<h2 class="text-2xl font-semibold mt-12 mb-4">Mais ferramentas de tempo</h2>
		<ToolsGrid />
	</article>
</Base>

<style>
	.app-card {
		background: var(--color-canvas-elevated);
		border: 1px solid var(--color-hairline);
		box-shadow: var(--shadow-whisper);
	}
	.article :global(h2) {
		font-size: 1.5rem;
		font-weight: 600;
		margin-top: 2.5rem;
		margin-bottom: 0.75rem;
		line-height: 1.25;
	}
	.article :global(h3) {
		font-size: 1.1rem;
		font-weight: 600;
		margin-top: 1.5rem;
		margin-bottom: 0.4rem;
	}
	.article :global(p) {
		color: var(--color-body);
		margin-bottom: 0.8rem;
		line-height: 1.6;
	}
	.article :global(ul) {
		list-style: none;
		padding-left: 0;
		margin-bottom: 1rem;
	}
	.article :global(ul li) {
		position: relative;
		padding-left: 20px;
		color: var(--color-body);
		margin-bottom: 0.35rem;
		line-height: 1.6;
	}
	.article :global(ul li::before) {
		content: '';
		position: absolute;
		left: 2px;
		top: 9px;
		width: 7px;
		height: 7px;
		border-radius: 2px;
		background: var(--color-link);
	}
	.article :global(.faq-item) {
		padding: 14px 16px;
		border-radius: 12px;
		background: var(--color-canvas-elevated);
		border: 1px solid var(--color-hairline);
		box-shadow: var(--shadow-whisper);
		margin-bottom: 0.6rem;
	}
	.article :global(.faq-q) {
		font-size: 15px;
		font-weight: 600;
		color: var(--color-ink);
		margin-bottom: 4px;
	}
	.article :global(.faq-a) {
		font-size: 14px;
		color: var(--color-body);
		line-height: 1.6;
	}
	.article :global(strong) {
		color: var(--color-ink);
		font-weight: 600;
	}
</style>