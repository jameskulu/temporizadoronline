---
import { SITE_NAME } from '../data/site';
import { getLangFromUrl, useTranslations, localPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const nav = t.nav;
const footer = t.footer;
---
<footer class="site-footer">
	<div class="mx-auto max-w-page px-4 py-8 border-t" style="border-color:var(--color-hairline)">
		<div class="flex flex-col md:flex-row items-center justify-between gap-3 text-[13px]" style="color:var(--color-body)">
			<p>Â© {year} {SITE_NAME} â€” {footer.tagline}</p>
			<nav class="flex flex-wrap items-center justify-center gap-4">
				<a href={localPath(lang, '/temporizador/')} class="f-link">{nav.temporizador}</a>
				<a href={localPath(lang, '/pomodoro/')} class="f-link">{nav.pomodoro}</a>
				<a href={localPath(lang, '/cronometro/')} class="f-link">{nav.cronometro}</a>
				<a href={localPath(lang, '/intervalos/')} class="f-link">{nav.intervalos}</a>
				<a href={localPath(lang, '/meditacao/')} class="f-link">{nav.meditacao}</a>
				<a href={localPath(lang, '/sequencias/')} class="f-link">{nav.sequencias}</a>
			</nav>
		</div>
		<div class="mt-4 pt-4 border-t" style="border-color:var(--color-hairline)">
			<nav class="flex flex-wrap items-center justify-center gap-4 text-[12px]" style="color:var(--color-ink-muted)">
				<a href={localPath(lang, '/sobre/')} class="f-link">{footer.about}</a>
				<a href={localPath(lang, '/contato/')} class="f-link">{footer.contact}</a>
				<a href={localPath(lang, '/privacidade/')} class="f-link">{footer.privacy}</a>
				<a href={localPath(lang, '/termos/')} class="f-link">{footer.terms}</a>
			</nav>
		</div>
	</div>
</footer>

<style>
	.f-link {
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.f-link:hover {
		color: var(--color-link-deep);
	}
</style>