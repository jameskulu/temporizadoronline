{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "temporizador-rt",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"durable_objects": {
		"bindings": [{ "name": "ROOM", "class_name": "Room" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}